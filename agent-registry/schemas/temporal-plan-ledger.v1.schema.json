{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cadgrounded.local/schema/temporal-plan-ledger.v1.schema.json",
  "title": "CADGrounded Temporal Planning Ledger",
  "description": "Append-only project-state records. This schema does not represent or promote mechanical evidence.",
  "oneOf": [
    {
      "$ref": "#/$defs/plan"
    },
    {
      "$ref": "#/$defs/divergence_record"
    },
    {
      "$ref": "#/$defs/plan_reconciliation"
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z]+-[0-9]{4}$"
    },
    "plan": {
      "type": "object",
      "required": [
        "record_type",
        "schema_version",
        "record_id",
        "project_id",
        "created_at_utc",
        "state_binding",
        "projected_steps"
      ],
      "properties": {
        "record_type": {
          "const": "plan"
        },
        "schema_version": {
          "const": 1
        },
        "record_id": {
          "$ref": "#/$defs/id"
        },
        "project_id": {
          "type": "string"
        },
        "created_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "parent_plan_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "caused_by_divergence_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "state_binding": {
          "type": "object"
        },
        "projected_steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "step_id",
              "title",
              "depends_on",
              "write_authority",
              "status"
            ]
          }
        }
      },
      "additionalProperties": true
    },
    "divergence_record": {
      "type": "object",
      "required": [
        "record_type",
        "schema_version",
        "record_id",
        "project_id",
        "recorded_at_utc",
        "from_plan_id",
        "classification",
        "successor_plan_id"
      ],
      "properties": {
        "record_type": {
          "const": "divergence_record"
        },
        "schema_version": {
          "const": 1
        },
        "record_id": {
          "$ref": "#/$defs/id"
        },
        "project_id": {
          "type": "string"
        },
        "recorded_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "from_plan_id": {
          "$ref": "#/$defs/id"
        },
        "classification": {
          "type": "string"
        },
        "successor_plan_id": {
          "$ref": "#/$defs/id"
        }
      },
      "additionalProperties": true
    },
    "plan_reconciliation": {
      "type": "object",
      "required": [
        "record_type",
        "schema_version",
        "record_id",
        "project_id",
        "reconciled_at_utc",
        "plan_id",
        "step_outcomes",
        "revised_plan_id"
      ],
      "properties": {
        "record_type": {
          "const": "plan_reconciliation"
        },
        "schema_version": {
          "const": 1
        },
        "record_id": {
          "$ref": "#/$defs/id"
        },
        "project_id": {
          "type": "string"
        },
        "reconciled_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "plan_id": {
          "$ref": "#/$defs/id"
        },
        "step_outcomes": {
          "type": "array"
        },
        "revised_plan_id": {
          "$ref": "#/$defs/id"
        }
      },
      "additionalProperties": true
    }
  }
}
