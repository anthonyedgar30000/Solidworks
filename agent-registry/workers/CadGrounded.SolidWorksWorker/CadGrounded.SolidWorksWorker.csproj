<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CadGrounded.SolidWorksWorker</AssemblyName>
    <RootNamespace>CadGrounded.SolidWorksWorker</RootNamespace>
    <SolidWorksDir Condition="'$(SolidWorksDir)' == ''">C:\Program Files\SOLIDWORKS Corp\SOLIDWORKS</SolidWorksDir>
    <UseNuGetSolidWorksInterop Condition="'$(UseNuGetSolidWorksInterop)' == ''">false</UseNuGetSolidWorksInterop>
    <SolidWorksInteropPackageVersion Condition="'$(SolidWorksInteropPackageVersion)' == ''">32.1.0</SolidWorksInteropPackageVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseNuGetSolidWorksInterop)' != 'true'">
    <Reference Include="SolidWorks.Interop.sldworks">
      <HintPath>$(SolidWorksDir)\SolidWorks.Interop.sldworks.dll</HintPath>
      <Private>true</Private>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
    <Reference Include="SolidWorks.Interop.swconst">
      <HintPath>$(SolidWorksDir)\SolidWorks.Interop.swconst.dll</HintPath>
      <Private>true</Private>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(UseNuGetSolidWorksInterop)' == 'true'">
    <PackageReference Include="SolidWorks.Interop.sldworks" Version="$(SolidWorksInteropPackageVersion)" />
    <PackageReference Include="SolidWorks.Interop.swconst" Version="$(SolidWorksInteropPackageVersion)" />
  </ItemGroup>
</Project>
